# ──────────────────────────────────────────────
#  Vision Stream System — local environment
#  Override docker-compose.yml defaults here.
# ──────────────────────────────────────────────

# YOLOv8s is significantly more accurate than nano (yolov8n) while still
# being fast enough for real-time processing.  Ultralytics will download
# the weights automatically on first run if not already present.
YOLO_MODEL=models/yolov8n.pt

# YOLO inference input size. 416 is usually a good speed/accuracy compromise on CPU.
YOLO_IMGSZ=416

# Lower threshold so partially-occluded or seated persons (viewed from
# above via a fisheye lens) are also detected.
# 0.30 catches detections that nano+0.5 would miss; raise back toward
# 0.5 if you get too many false positives.
CONFIDENCE_THRESHOLD=0.50

# Video file served by vstreamer (path inside the container)
VIDEO_FILE=/video/result.mp4

# vstreamer: copy input video bitstream instead of re-encoding with libx264.
# true = lower CPU and usually smoother real-time pacing for H.264 inputs.
STREAMER_COPY_VIDEO=true

# Dashboard build-time overrides.
# Leave VITE_PROCESSOR_URL empty to keep API/socket on the dashboard origin,
# but send MJPEG directly to vprocessor on port 8000.
VITE_PROCESSOR_URL=
VITE_STREAM_URL=http://78.156.131.250:8000/stream
VITE_HLS_URL=/hls/stream.m3u8
VITE_VIDEO_MODE=hls
# Delay metadat proti videu (ms) pro HLS synchronizaci.
VITE_METADATA_DELAY_MS=2500
VITE_WEBRTC_URL=
VITE_USE_WEBRTC=true

# Pipeline profiling (vprocessor)
# When true, processor logs average detect/encode/write/emit timing breakdown.
PROFILE_PIPELINE=true
PROFILE_LOG_INTERVAL_SECONDS=5

# Performance tuning (vprocessor)
# Dominant bottleneck is detector.detect(); lowering scale speeds up inference.
# 0.45 is a conservative trade-off; tune together with YOLO_IMGSZ.
INFERENCE_SCALE=0.45

# Global detection toggle (YOLO inference).
# false = raw stream only (no detection boxes/events), useful to isolate non-YOLO bottlenecks.
ENABLE_DETECTION=true

# Run detection every N-th frame (1=every frame, 2=every second, 3=every third).
# Higher value usually increases FPS but can reduce temporal accuracy.
DETECT_EVERY_N=1

# Flush JSONL metadata every N frames instead of each frame to reduce disk I/O overhead.
# 1 = safest durability, 10 = better throughput with minimal practical risk.
METADATA_FLUSH_EVERY=10

# Small FIFO queue between RTSP reader and MJPEG processor.
# Higher value smooths brief timing jitter but increases latency.
RAW_FRAME_QUEUE_SIZE=16

# If true, MJPEG /stream is encoded directly from raw frames in the RTSP grabber.
# This makes the live stream independent from YOLO/disk pipeline timing.
STREAM_FROM_RAW=false

# MJPEG output tuning for /stream.
# Lowering resolution/quality often helps much more than detector tweaks for browser smoothness.
STREAM_SCALE=0.5
STREAM_JPEG_QUALITY=70

# Enable WebRTC signaling endpoint in vprocessor.
ENABLE_WEBRTC=true

# Enable LL-HLS generation in vprocessor.
ENABLE_HLS=true
HLS_OUTPUT_DIR=/app/hls
# IMPORTANT: For detection boxes in HLS, source must be annotated stream
# from vprocessor (not raw RTSP).
HLS_SOURCE_URL=http://78.156.131.250:8000/stream
# Lower values reduce latency but increase overhead.
HLS_SEGMENT_TIME=1.0
HLS_LIST_SIZE=6
HLS_VIDEO_BITRATE=2200k
HLS_MAXRATE=2800k
HLS_BUFSIZE=4400k

# Set to false for pure performance benchmark (disables MP4/JSONL per-frame writes).
RECORD_OUTPUT=true
