# ──────────────────────────────────────────────────────────────────────────────
#  Vision Stream System — environment configuration example
#
#  Copy this file to .env and adjust the values to your needs:
#    cp .env.example .env
#
#  .env is intentionally excluded from version control (.gitignore) so that
#  local overrides do not leak into the repository.
# ──────────────────────────────────────────────────────────────────────────────


# ── vstreamer ─────────────────────────────────────────────────────────────────

# Path to the input video file *inside the container*.
# The ./videos host directory is bind-mounted to /videos (read-only).
VIDEO_FILE=/videos/input.mp4


# ── vprocessor — YOLO model ───────────────────────────────────────────────────

# Which YOLOv8 weights to use.  Ultralytics downloads them automatically on
# first run if the file is not already present inside the container.
#
# Available variants (accuracy vs. speed trade-off):
#   yolov8n.pt  — nano    · fastest,  least accurate  (~3.2 M params)
#   yolov8s.pt  — small   · fast,     good accuracy   (~11  M params)  ← recommended
#   yolov8m.pt  — medium  · moderate, better accuracy (~25  M params)
#   yolov8l.pt  — large   · slower,   high accuracy   (~44  M params)
#   yolov8x.pt  — xlarge  · slowest,  best accuracy   (~68  M params)
#
# TIP: Switch from nano → small (yolov8s.pt) to significantly improve detection
#      of partially-occluded or seated persons viewed from overhead cameras.
YOLO_MODEL=models/yolov8n.pt


# ── vprocessor — detection threshold ─────────────────────────────────────────

# Minimum confidence score (0.0 – 1.0) required for a detection to be kept.
#
# Lowering this value helps detect:
#   • persons that are seated or in non-standing poses
#   • persons partially occluded by furniture or equipment
#   • persons viewed at extreme angles (e.g. top-down fisheye cameras)
#
# Raising this value reduces false positives at the cost of missing detections.
#
# Suggested range:
#   0.25 – 0.35   if you are missing real persons (under-detection)
#   0.40 – 0.60   if you are getting too many false positives (over-detection)
CONFIDENCE_THRESHOLD=0.50


# ── vprocessor — HTTP API ─────────────────────────────────────────────────────

# Address and port on which the vprocessor FastAPI server listens.
# These rarely need to change unless you run multiple instances.
HOST=0.0.0.0
PORT=8000
